{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-control-plane.local/benchmarks/v0.1/result.schema.json",
  "title": "Skill benchmark v0.1 run result",
  "type": "object",
  "required": ["benchmark_version","task_id","suite","arm","corpus","model","run_id","task_success","success_details","required_skills","activated_skills","required_skill_recall","wrong_skill_count","discovery_count","repeated_discovery_count","skill_body_load_count","stage_transition_success","bundle_create_count","bundle_extend_count","bundle_reuse_count","session_restore_success","llm_input_tokens","llm_output_tokens","llm_total_tokens","cached_tokens","query_embedding_calls","wall_time_ms","total_tool_calls","control_plane_telemetry"],
  "properties": {
    "benchmark_version":{"const":"benchmark-v0.1"}, "suite":{"enum":["scaling","runtime"]},
    "arm":{"enum":["native","control-plane"]}, "corpus":{"enum":["S32","S64","S128"]},
    "task_success":{"type":"boolean"}, "required_skill_recall":{"type":"number","minimum":0,"maximum":1},
    "wrong_skill_count":{"type":"integer","minimum":0}, "discovery_count":{"type":"integer","minimum":0},
    "repeated_discovery_count":{"type":"integer","minimum":0}, "skill_body_load_count":{"type":"integer","minimum":0},
    "llm_input_tokens":{"type":"integer","minimum":0}, "llm_output_tokens":{"type":"integer","minimum":0},
    "llm_total_tokens":{"type":"integer","minimum":0}, "cached_tokens":{"type":["integer","null"],"minimum":0},
    "query_embedding_calls":{"type":"integer","minimum":0}, "wall_time_ms":{"type":"integer","minimum":0},
    "total_tool_calls":{"type":"integer","minimum":0}
  },
  "additionalProperties": true
}
